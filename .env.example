# ParkFlow AI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=ParkFlow AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-32chars

# ============================================================
# DATABASE
# ============================================================
# SQLite (default for local development - zero config)
DATABASE_URL=sqlite+aiosqlite:///./parkflow.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/parkflow

# ============================================================
# BACKEND SERVER
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# FRONTEND
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================================
# IOT MODE: "simulation" | "thingspeak" | "mqtt" | "hybrid"
# ============================================================
IOT_MODE=simulation
SIMULATION_INTERVAL_SECONDS=5
OCCUPANCY_THRESHOLD_CM=50.0

# ============================================================
# THINGSPEAK (optional - leave blank to disable)
# ============================================================
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_POLL_INTERVAL_SECONDS=15
THINGSPEAK_BASE_URL=https://api.thingspeak.com

# ============================================================
# MQTT (optional - leave blank to disable)
# ============================================================
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_TOPIC_PREFIX=parkflow
